# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Random secret used by Better Auth to sign session tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Your production URL. Leave unset locally; Better Auth falls back to
# VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL automatically on Vercel.
# BETTER_AUTH_URL="https://your-site.vercel.app"

# Vercel Blob storage token (create a Blob store in the Vercel dashboard,
# then copy its token here — Vercel also injects this automatically if the
# Blob store is linked to the project).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
